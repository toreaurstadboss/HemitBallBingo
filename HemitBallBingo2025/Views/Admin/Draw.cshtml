@using HemitBallBingo2025.ViewModels
@model DrawViewModel

<h5 class="text-center">
    Lottery Draw: @Model.DrawName (@Model.DrawDate.ToString("dd.MM.yyyy"))
</h5>
<div class="text-center mb-4">
    <form >
        <input type="hidden" name="drawId" value="@Model.DrawId" />
        <button type="submit" class="btn btn-primary btn-lg">
            <i class="fas fa-random"></i> Draw Next Ticket
        </button>
    </form>
</div>

@if (!string.IsNullOrEmpty(Model.LastDrawnMessage))
{
    <h3 class="text-center text-warning mb-3">
        <i class="fas fa-times-circle"></i> @Model.LastDrawnMessage
    </h3>
}