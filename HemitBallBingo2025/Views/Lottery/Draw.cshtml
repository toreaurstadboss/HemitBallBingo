@using HemitBallBingo2025.ViewModels
@model DrawViewModel

<link rel="stylesheet" href="~/css/draw.css" />

<a href="~/Lottery/Index" class="btn btn-info">🔙 Vis trekninger</a>

<div class="float-end">

    <!-- Picture Box Column -->

    <div id="pictureBox2" class="picture-box img-fluid border rounded p-3" style="width: 250px; height: 250px; background-color: #f8f9fa;">
        @if (TempData["DrawnTicketImage"] != null)
        {
            <img src='@TempData["DrawnTicketImage"]' alt="Trekkt billett bilde" class="img-fluid" />
        }
    </div>

    <h5>LODD I BOLLA :  <span style="font-size:3rem;font-family:'Microsoft Sans Serif'">(@Model.Tickets.Count)</span></h5>

</div>

<div class="row">


    <div class="col-mb-2">
        <h2 class="text-center">
            Lottery Draw: @Model.DrawName (@Model.DrawDate.ToString("dd.MM.yyyy"))
        </h2>

    </div>

    <div class="text-center mb-2">
        <form asp-action="DrawNextTicket" asp-controller="Lottery" method="post" role="form">
            <input type="hidden" name="drawId" value="@Model.DrawId" />
            <button type="submit" class="draw-btn" title="Klikk her for å trekke neste lodd!">
                <span class="draw-btn__icons">
                    <i class="fas fa-ticket-alt"></i>
                    <i class="fas fa-dice draw-btn__dice"></i>
                </span>
                <span class="draw-btn__label">Trekk neste lodd!</span>
            </button>
        </form>
    </div>

</div>

@if (!string.IsNullOrEmpty(Model.LastDrawnMessage))
{
    <div class="drawn-ticket-container text-center my-3">
        <div class="drawn-ticket-message show d-flex flex-column align-items-center gap-1">
            <i class="fas fa-smile text-warning display-6"></i>
            <h2 class="text-uppercase mb-3" style="white-space: pre-line;">@Model.LastDrawnMessage</h2>
        </div>
    </div>
}

<!-- List of winners in the lottery draw -->                        
@if (Model.ThirdPrize != null || Model.SecondPrize != null || Model.FirstPrize != null)
{
    <h3 class="text-center text-warning mb-3">🏆 Gratulerer til vinnere! 🏆</h3>

    <div class="podium-stage">

        <!-- 2nd place — left, medium height -->
        <div class="podium-slot podium-slot--2 @(Model.SecondPrize == null ? "podium-slot--empty" : "")">
            @if (Model.SecondPrize != null)
            {
                <div class="podium-winner-info">
                    <div class="podium-medal">🥈</div>
                    <div class="podium-name">@Model.SecondPrize.OwnerName</div>
                    <div class="podium-subtitle">Du er KRONPRINSEN /<br />KRONPRINSESSA av BallBingo!</div>
                    <div class="podium-ticket">Lodd #@Model.SecondPrize.TicketNumber</div>
                </div>
            }
            <div class="podium-block podium-block--silver">
                <span class="podium-rank">2</span>
            </div>
        </div>

        <!-- 1st place — center, tallest -->
        <div class="podium-slot podium-slot--1 @(Model.FirstPrize == null ? "podium-slot--empty" : "")">
            @if (Model.FirstPrize != null)
            {
                <div class="podium-winner-info">
                    <div class="podium-medal">🥇</div>
                    <div class="podium-name">@Model.FirstPrize.OwnerName</div>
                    <div class="podium-subtitle">Du er KONGEN /<br />DRONNINGA av BallBingo!</div>
                    <div class="podium-ticket">Lodd #@Model.FirstPrize.TicketNumber</div>
                </div>
            }
            <div class="podium-block podium-block--gold">
                <span class="podium-rank">1</span>
            </div>
        </div>

        <!-- 3rd place — right, shortest -->
        <div class="podium-slot podium-slot--3 @(Model.ThirdPrize == null ? "podium-slot--empty" : "")">
            @if (Model.ThirdPrize != null)
            {
                <div class="podium-winner-info">
                    <div class="podium-medal">🥉</div>
                    <div class="podium-name">@Model.ThirdPrize.OwnerName</div>
                    <div class="podium-subtitle">Du er PRINSEN /<br />PRINSESSA av BallBingo!</div>
                    <div class="podium-ticket">Lodd #@Model.ThirdPrize.TicketNumber</div>
                </div>
            }
            <div class="podium-block podium-block--bronze">
                <span class="podium-rank">3</span>
            </div>
        </div>

    </div>
}

<!-- Badge list for remaining tickets -->

<div class="d-flex flex-wrap gap-2 mt-4">
    @foreach (var ticket in Model.Tickets)
    {
        <span class="badge bg-info text-black text-white fs-5 px-3 py-2">
            @ticket.OwnerName
        </span>
    }
</div>

<!-- Picture Box Column -->
<div class="col-mb-2 d-flex justify-content-center align-items-center">
    <div id="pictureBox" class="picture-box border rounded p-3" style="width: 250px; height: 250px; background-color: #f8f9fa;">
        @if (TempData["DrawnTicketImage"] != null)
        {
            <img src='@TempData["DrawnTicketImage"]' alt="Trekkt billett bilde" class="img-fluid" />
        }
    </div>

</div>
