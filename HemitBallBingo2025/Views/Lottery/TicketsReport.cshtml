@using HemitBallBingo2025.ViewModels
@model TicketsReportViewModel

@{
    ViewData["Title"] = "Tickets Report";
}

<h2>Lodd-rapport for trekning: @Model.DrawName den @Model.Created.ToString("dd.MM.yyyy")</h2>

<div class="table-responsive mt-4">
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>Loddnummer</th>
                <th>Eiernavn</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Tickets != null && Model.Tickets.Any())
            {
                int index = 1;
                foreach (var ticket in Model.Tickets)
                {
                    <tr>
                        <td>@index</td>
                        <td>@ticket.TicketNumber</td>
                        <td>@ticket.OwnerName</td>
                    </tr>
                    index++;
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center text-muted">Ingen lodd registrert.</td>
                </tr>
            }
        </tbody>
    </table>
</div>