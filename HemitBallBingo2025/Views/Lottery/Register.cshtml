@using HemitBallBingo2025.ViewModels
@model TicketsViewModel

@{
    ViewData["Title"] = "Register 1-10 Tickets";
}

<h2>Registrer lodd-innhavere for trekning: @Model.LotteryDraw?.Name den @Model.LotteryDraw?.Created.ToString("dd.MM.yyyy")</h2>

<form asp-action="RegisterTickets" asp-controller="Lottery">

    <div class="mb-3">
        <p class="text-muted">Oppgi navn på opptil 10 stk til å inneha lodd i trekningen. Loddnr blir et løpenr.</p>
    </div>

    <div class="row bg-secondary p-3 text-white rounded">
        @for (int i = 0; i < Model.Tickets.Count; i++)
        {
            <div class="col-md-6 mb-3">
                <label asp-for="@Model.Tickets[i].OwnerName" class="form-label">Lodd @(i + 1)</label>
                <input asp-for="@Model.Tickets[i].OwnerName" class="form-control" />
            </div>
        }
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-success" id="submitBtn">Lagre lodd</button>
    </div>
</form>

@section Scripts {

    <script>
        document.querySelector('form').addEventListener('submit', function (e) {
            const inputs = document.querySelectorAll('input[name^="Tickets"][name$="OwnerName"]');
            const hasValue = Array.from(inputs).some(input => input.value.trim() !== '');
            if (!hasValue) {
                e.preventDefault();
                alert('Oppgi minst en navn på eier av lodd.');
            }
        });
    </script>

}