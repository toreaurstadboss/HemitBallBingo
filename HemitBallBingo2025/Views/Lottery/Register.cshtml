@using HemitBallBingo2025.ViewModels
@model TicketsViewModel

@{
    ViewData["Title"] = "Register 1-10 Tickets";
}

<a href="~/Lottery/Index" class="btn btn-info">🔙 Vis trekninger</a>

<h2>
    Registrer lodd-innhavere for trekning: @Model.LotteryDraw?.Name den @Model.LotteryDraw?.Created.ToString("dd.MM.yyyy")
</h2>

@* Using asp-action and asp-controller handles the AntiForgeryToken automatically *@

<form asp-action="Register" asp-controller="Lottery" method="post" role="form">

    @* This hidden field ensures the DrawId is posted back to the controller *@
    <input type="hidden" asp-for="DrawId" />

    <div class="mb-3">
        <p class="text-muted">
            <b>Oppgi navn på opptil 10 stk til å inneha lodd i trekningen. Loddnr blir satt til et løpenr innad for trekningen.</b>
        </p>
    </div>

    @* The loop correctly generates indexed names (e.g., Tickets.OwnerName) *@
    <div class="row bg-secondary p-3 text-white rounded">
        @for (int i = 0; i < Model.Tickets.Count; i++)
        {
            <div class="col-md-6 mb-3">

                @* This label correctly links to the input field *@
                <label asp-for="Tickets[i].OwnerName" class="form-label">Lodd @(i + 1)</label>

                @* ONLY ONE INPUT FIELD IS NEEDED FOR OwnerName *@
                <input asp-for="Tickets[i].OwnerName" class="form-control loddinnehaver" />

                @* Ensure the validation span is within the loop so it can target the specific input error *@
                <span asp-validation-for="Tickets[i].OwnerName" class="text-danger"></span>

                @* REMOVED: The conflicting hidden input field you added previously *@
            </div>
        }
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-success" id="submitBtn">Lagre lodd</button>
    </div>

    @* A general summary area for non-field-specific errors *@
    <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>
</form>

@section Scripts {
    @* Include standard validation scripts if you don't already have them in a shared layout file *@
 

    <script>
        document.querySelector('form').addEventListener('submit', function (e) {
            const inputs = document.querySelectorAll('input.loddinnehaver');
            const hasValue = Array.from(inputs).some(input => input.value.trim() !== '');
            if (!hasValue) {
                // e.preventDefault(); // Uncomment this line to enforce the validation client-side
                toastr.warning('Oppgi minst ett navn før du lagrer.');
            }
        });

        // Optional: Show success message if TempData["Success"] is set
        @if (TempData["Success"] != null)
        {
                <text>
                    toastr.success('@TempData["Success"]');
                </text>
        }
    </script>
}
