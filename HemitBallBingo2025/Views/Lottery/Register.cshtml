@using HemitBallBingo2025.ViewModels
@model TicketsViewModel

@{
    ViewData["Title"] = "Register 1-10 Tickets";
}

<a href="~/Lottery/Index" class="btn btn-info">🔙 Vis trekninger</a>

<h2>
    Registrer lodd-innhavere for trekning: @Model.LotteryDraw?.Name den @Model.LotteryDraw?.Created.ToString("dd.MM.yyyy")
</h2>

<form asp-action="Register" asp-controller="Lottery" method="post" role="form">

    <input type="hidden" asp-for="DrawId" />

    <div class="mb-3">
        <label class="fw-bold me-2">Oppgi deltagere via å lime inn tekst:</label>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="ShowRawTicketInput"
                   id="showRawYes" value="true" @(Model.ShowRawTicketInput ? "checked" : "") />
            <label class="form-check-label" for="showRawYes">Ja</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" name="ShowRawTicketInput"
                   id="showRawNo" value="false" @(!Model.ShowRawTicketInput ? "checked" : "") />
            <label class="form-check-label" for="showRawNo">Nei</label>
        </div>
    </div>

    <!-- Raw textarea input section -->
    <div id="rawInputSection" @(!Model.ShowRawTicketInput ? "style=\"display:none\"" : "")>
        <div class="mb-3">
            <label asp-for="TicketsRaw" class="form-label fw-bold">
                Lim inn deltakernavn (ett per linje eller skilt med skilletegn komma eller kolon):
            </label>
            <textarea asp-for="TicketsRaw" class="form-control" rows="10"
                      placeholder="Skriv eller lim inn navn på deltagerne.."></textarea>
        </div>
    </div>

    <!-- Individual ticket input section -->
    <div id="ticketInputSection" @(Model.ShowRawTicketInput ? "style=\"display:none\"" : "")>
        <div class="mb-3">
            <p class="text-muted">
                <b>Oppgi navn på opptil 10 stk til å inneha lodd i trekningen. Loddnr blir satt til et løpenr innad for trekningen.</b>
            </p>
        </div>
        <div class="row bg-secondary p-3 text-white rounded">
            @for (int i = 0; i < Model.Tickets.Count; i++)
            {
                <div class="col-md-6 mb-3">
                    <label asp-for="Tickets[i].OwnerName" class="form-label">Lodd @(i + 1)</label>
                    <input asp-for="Tickets[i].OwnerName" class="form-control loddinnehaver" />
                    <span asp-validation-for="Tickets[i].OwnerName" class="text-danger"></span>
                </div>
            }
        </div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-success" id="submitBtn">Lagre lodd</button>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger mt-2"></div>
</form>

@section Scripts {
    <script>
        const radios = document.querySelectorAll('input[name="ShowRawTicketInput"]');
        const rawSection = document.getElementById('rawInputSection');
        const ticketSection = document.getElementById('ticketInputSection');

        // Initialize visibility on page load from current radio state
        (function () {
            const isRaw = document.querySelector('input[name="ShowRawTicketInput"]:checked')?.value === 'true';
            rawSection.style.display = isRaw ? '' : 'none';
            ticketSection.style.display = isRaw ? 'none' : '';
        })();

        radios.forEach(radio => {
            radio.addEventListener('change', function () {
                const isRaw = this.value === 'true';
                rawSection.style.display = isRaw ? '' : 'none';
                ticketSection.style.display = isRaw ? 'none' : '';
            });
        });

        document.querySelector('form').addEventListener('submit', function (e) {
            const isRaw = document.querySelector('input[name="ShowRawTicketInput"]:checked')?.value === 'true';

            if (isRaw) {
                const rawText = document.getElementById('TicketsRaw').value.trim();
                if (!rawText) {
                    e.preventDefault();
                    toastr.warning('Oppgi minst ett navn i tekstfeltet før du lagrer.');
                }
            } else {
                const inputs = document.querySelectorAll('input.loddinnehaver');
                const hasValue = Array.from(inputs).some(input => input.value.trim() !== '');
                if (!hasValue) {
                    e.preventDefault();
                    toastr.warning('Oppgi minst ett navn før du lagrer.');
                }
            }
        });

        @if (TempData["Success"] != null)
        {
            <text>toastr.success('@TempData["Success"]');</text>
        }
    </script>
}
